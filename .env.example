# Google AI Studio (https://aistudio.google.com/apikey) — solo la usa el pipeline (GitHub Action)
GEMINI_API_KEY=

# Cadena de fallback de modelos, separada por comas (opcional)
# GEMINI_MODELS=gemini-2.5-pro,gemini-3.5-flash,gemini-2.5-flash

# Upstash Redis REST (https://console.upstash.com) — las usan el pipeline y las API routes (Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google AdSense (opcional) — el banner solo se muestra si ambas están definidas.
# También hay que definirlas en Vercel (Project Settings → Environment Variables).
PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_SLOT=XXXXXXXXXX
