---
import '@/styles/globals.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Rice Tech News',
  description = 'Daily tech & programming news, summarized by AI · Noticias diarias de tecnología resumidas por IA',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
